# Sao chép thành .env.local rồi điền giá trị thật. KHÔNG commit .env.local.

# --- Database ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# --- NextAuth ---
# NEXTAUTH_URL cũng dùng để dựng link trong email (mở khoá tài khoản, nút "Sửa ngay"/"Xem món" trong email thông báo).
# Production: domain thật, vd https://nayangi.io.vn
NEXTAUTH_URL=http://localhost:3000
# Chuỗi ngẫu nhiên dài (vd: openssl rand -base64 32). Còn dùng làm khoá HMAC cho OTP/token Quên mật khẩu.
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Site công khai (sitemap, robots, ảnh trong email) ---
NEXT_PUBLIC_SITE_URL=https://nayangi.io.vn

# --- Nominatim (OSM geocode) — email liên hệ gắn vào User-Agent theo usage policy ---
# Để trống thì dùng NEXTAUTH_URL làm thông tin liên hệ.
NOMINATIM_CONTACT_EMAIL=

# --- Email (SMTP) — Quên mật khẩu, xác thực email, email thông báo (docs/notifications.md mục 5) ---
# Để trống SMTP_HOST ở môi trường dev: email được IN RA CONSOLE server thay vì gửi thật.
# Ở production bắt buộc cấu hình, nếu không email không gửi được (thông báo trong app vẫn hoạt động).
# Gmail: smtp.gmail.com — cần bật Xác minh 2 bước rồi tạo "Mật khẩu ứng dụng" (App password) 16 ký tự.
SMTP_HOST=
# 587 (STARTTLS) hoặc 465 (SSL). SMTP_SECURE mặc định true khi cổng 465.
SMTP_PORT=587
SMTP_SECURE=
# Gmail: địa chỉ Gmail đầy đủ, vd ten.cua.ban@gmail.com
SMTP_USER=
# Gmail: App password 16 ký tự (bỏ dấu cách), KHÔNG phải mật khẩu đăng nhập Gmail.
SMTP_PASS=
# Tên + địa chỉ người gửi. Với Gmail, địa chỉ trong <> phải trùng SMTP_USER.
MAIL_FROM="NayAnGi <ten.cua.ban@gmail.com>"

# --- Realtime thông báo (Pusher Channels) — docs/notifications.md mục 4 ---
# Tạo app Channels tại dashboard.pusher.com (gói Sandbox miễn phí), cluster ap1 (Singapore).
# Để trống: thông báo vẫn hoạt động, app tự chuyển sang hỏi server mỗi 60 giây thay vì realtime.
PUSHER_APP_ID=
PUSHER_KEY=
# Bí mật — chỉ dùng ở server, TUYỆT ĐỐI không thêm tiền tố NEXT_PUBLIC_.
PUSHER_SECRET=
PUSHER_CLUSTER=ap1
# Phía trình duyệt: giá trị giống PUSHER_KEY / PUSHER_CLUSTER. Đổi xong phải build/khởi động lại dev server.
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=ap1

# --- Cron dọn ảnh rác (Vercel Cron → /api/cron/cleanup-images, docs/database.md mục 12b) ---
# Chuỗi ngẫu nhiên ≥ 16 ký tự (khuyên dùng 32 byte). Vercel tự gửi kèm header
# "Authorization: Bearer <CRON_SECRET>" khi gọi cron; route từ chối (401) nếu sai/thiếu.
# Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Để trống: route cron luôn trả 401 (không dọn tự động); trang /admin/don-anh và script vẫn dùng được.
CRON_SECRET=
