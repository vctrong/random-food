# Sao chép thành .env.local rồi điền giá trị thật. KHÔNG commit .env.local.

# --- Database ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# --- NextAuth ---
# NEXTAUTH_URL cũng dùng để dựng link "Mở khoá tài khoản" trong email.
NEXTAUTH_URL=http://localhost:3000
# Chuỗi ngẫu nhiên dài (vd: openssl rand -base64 32). Còn dùng làm khoá HMAC cho OTP/token Quên mật khẩu.
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Site công khai (sitemap, robots, ảnh trong email) ---
NEXT_PUBLIC_SITE_URL=https://nayangi.io.vn

# --- Nominatim (OSM geocode) — email liên hệ gắn vào User-Agent theo usage policy ---
# Để trống thì dùng NEXTAUTH_URL làm thông tin liên hệ.
NOMINATIM_CONTACT_EMAIL=

# --- Email (SMTP) — luồng Quên mật khẩu, xem docs/forgot-password.md ---
# Để trống SMTP_HOST ở môi trường dev: email được IN RA CONSOLE server thay vì gửi thật.
# Ở production bắt buộc cấu hình, nếu không API sẽ báo "Không gửi được email".
SMTP_HOST=
# 587 (STARTTLS) hoặc 465 (SSL). SMTP_SECURE mặc định true khi cổng 465.
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Tên + địa chỉ người gửi. Với Gmail phải trùng tài khoản SMTP_USER.
MAIL_FROM="NayAnGi <no-reply@nayangi.io.vn>"
